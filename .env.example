# Copy to .env for local development. Never commit real credentials.
APP_ENV=local
APP_URL=http://localhost/luntianAi
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_FACEBOOK_APP_ID=

GCASH_ACCOUNT_NAME=
GCASH_MOBILE=
GCASH_PRO_MONTHLY_PHP=1499
GCASH_PRO_YEARLY_PHP=14390

# Payment proof storage: use local for persistent local development, supabase on Vercel
PAYMENT_STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PAYMENT_BUCKET=payment-proofs

ADMIN_SECRET=
SESSION_SECRET=
